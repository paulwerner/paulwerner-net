# Template for local/prod Docker Compose environment.
# Copy to .env and fill in real values. Never commit .env.

# ---- MySQL ----
# Root password for the MySQL container (used only by MySQL itself).
MYSQL_ROOT_PASSWORD=change-me
# Database Ghost will connect to.
MYSQL_DATABASE=ghost
# Non-root user Ghost will authenticate as.
MYSQL_USER=ghost
# Password for MYSQL_USER. Keep in sync with GHOST_DATABASE_PASSWORD below.
MYSQL_PASSWORD=change-me

# ---- Ghost database connection ----
# Hostname inside the Docker network — matches the mysql service name.
GHOST_DATABASE_HOST=mysql
# Must match MYSQL_USER.
GHOST_DATABASE_USER=ghost
# Must match MYSQL_PASSWORD.
GHOST_DATABASE_PASSWORD=change-me
# Must match MYSQL_DATABASE.
GHOST_DATABASE_NAME=ghost

# ---- Ghost public URL ----
# The public URL Ghost advertises in feeds, emails, and canonical links.
GHOST_URL=https://blog.paulwerner.net

# ---- Ghost outbound mail (transactional SMTP) ----
# Placeholders — configure when a real mail provider is chosen.
GHOST_MAIL_TRANSPORT=SMTP
GHOST_MAIL_HOST=smtp.example.com
GHOST_MAIL_PORT=587
GHOST_MAIL_USER=change-me
GHOST_MAIL_PASSWORD=change-me

# ---- Ghost staff device verification ----
# 2FA via email on unrecognized devices. Set to false while no SMTP provider
# is configured; re-enable (true) once outbound mail works.
SECURITY_STAFF_DEVICE_VERIFICATION=false

# ---- Caddy / public domains ----
# Root domain — serves the static landing page.
DOMAIN=paulwerner.net
# Blog subdomain — reverse-proxied to the Ghost container.
BLOG_SUBDOMAIN=blog.paulwerner.net

# ---- Booking service (appointment scheduler) ----
# Deliberately separate from GHOST_MAIL_* above — those stay reserved for a
# future newsletter bulk provider. Booking mail goes through Proton SMTP
# submission directly: create an SMTP token for the sender address at
# https://account.proton.me/mail/imap-smtp (available on the Unlimited plan).
BOOKING_SMTP_HOST=smtp.protonmail.ch
BOOKING_SMTP_PORT=587
BOOKING_SMTP_USER=bookings@paulwerner.net
# The Proton SMTP token — never an account password.
BOOKING_SMTP_PASSWORD=change-me
# From header on all booking emails. Usually equals BOOKING_SMTP_USER.
BOOKING_FROM_ADDRESS=bookings@paulwerner.net
# Address that receives the calendar invites; Proton Mail auto-adds them to
# Proton Calendar. Must differ from BOOKING_FROM_ADDRESS, or the invite is
# treated as self-organized and not added.
BOOKING_OWNER_EMAIL=change-me@proton.me
# Secret Proton Calendar "share via link" URL (busy-only Limited view).
# Treat like a password — anyone with it can read busy/free times.
BOOKING_BUSY_ICS_URL=https://calendar.proton.me/api/calendar/v1/url/change-me/calendar.ics
# How long the polled busy calendar is trusted before re-fetching (seconds).
BOOKING_BUSY_TTL_SECONDS=300
# Bookings are hard-deleted this many days after the appointment (GDPR).
BOOKING_RETENTION_DAYS=90

# ---- Imprint address ----
# Postal address required by German DDG §5. Kept out of git — set in .env.
# Caddy renders these into site/imprint/index.html at request time via the
# `templates` directive (scoped to /imprint/* only).
IMPRINT_STREET=Your Street 123
IMPRINT_CITY=12345 City
