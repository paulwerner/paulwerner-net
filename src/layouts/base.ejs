<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page.title %></title>
  <meta name="description" content="<%= page.description %>">

  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <link rel="preload" href="/assets/fonts/TravelingTypewriter.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/source-serif-4-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>

  <link rel="stylesheet" href="/assets/css/main.css">
</head>
<body class="bg-bg text-text font-serif antialiased min-h-screen flex flex-col">

  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-bg focus:text-link focus:border focus:border-accent focus:px-3 focus:py-2 focus:rounded">Skip to content</a>

<%- body %>

<%- include('../partials/footer.ejs', { page: page, navPages: navPages }) %>

  <script>
    // Scroll position bar (styles: .scroll-thumb in styles/main.css).
    (() => {
      const root = document.documentElement;
      const thumb = document.createElement('div');
      thumb.className = 'scroll-thumb';
      thumb.setAttribute('aria-hidden', 'true');
      document.body.appendChild(thumb);
      root.classList.add('has-scroll-thumb');

      let hideTimer;
      const update = () => {
        const view = window.innerHeight;
        const total = root.scrollHeight;
        if (total <= view + 1) return thumb.classList.remove('is-visible');
        const height = Math.max(32, (view * view) / total);
        const travel = (window.scrollY / (total - view)) * (view - height);
        thumb.style.height = `${height}px`;
        thumb.style.transform = `translateY(${travel}px)`;
        thumb.classList.add('is-visible');
        clearTimeout(hideTimer);
        hideTimer = setTimeout(() => thumb.classList.remove('is-visible'), 900);
      };
      window.addEventListener('scroll', update, { passive: true });
    })();

    document.querySelectorAll('[data-year]').forEach((el) => {
      el.textContent = new Date().getFullYear();
    });

    (() => {
      const back = document.getElementById('back-link');
      if (!back) return;
      try {
        const ref = document.referrer && new URL(document.referrer);
        if (ref && /^blog\./.test(ref.hostname)) {
          back.href = ref.origin + '/';
          const label = back.querySelector('[data-back-label]');
          if (label) label.innerHTML = '&larr; Back to blog';
        }
      } catch (_) {}
    })();
  </script>

</body>
</html>
